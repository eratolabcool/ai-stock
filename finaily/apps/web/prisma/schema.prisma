generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  sector      String?
  score       Int      @default(0)
  thesis      String?
  risks       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Theme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  score       Int      @default(0)
  description String?
}

model ResearchReport {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  createdAt   DateTime @default(now())
}
